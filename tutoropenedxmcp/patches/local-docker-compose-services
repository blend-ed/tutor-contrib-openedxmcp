openedxmcp:
  image: {{ OPENEDXMCP_IMAGE }}
  restart: unless-stopped
  environment:
    OPENEDXMCP_LMS_BASE_URL: "{{ OPENEDXMCP_LMS_BASE_URL }}"
    OPENEDXMCP_CMS_BASE_URL: "{{ OPENEDXMCP_CMS_BASE_URL }}"
    OPENEDXMCP_PORT: "{{ OPENEDXMCP_PORT }}"
  depends_on:
    - lms
    - cms
  healthcheck:
    test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ OPENEDXMCP_PORT }}/health').status==200 else 1)"]
    interval: 30s
    timeout: 5s
    retries: 3
    start_period: 10s
